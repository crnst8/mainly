#!/bin/sh
#
# mainly-provision — the server half of domain control.
#
# Creates and removes virtual mailboxes on a flat-file Postfix + Dovecot host,
# on behalf of a mainly install that reaches this machine over SSH.
#
# It is the only thing that key is allowed to run:
#
#   # ~mailprov/.ssh/authorized_keys
#   command="sudo /usr/local/sbin/mainly-provision --stdin",restrict ssh-ed25519 AAAA… mainly
#
# `restrict` denies port forwarding, agent forwarding, a PTY, X11 and ~/.ssh/rc,
# so the key cannot open a shell or tunnel — it can only cause this script to
# run. What the script will then do is decided here and in /etc/mainly-provision.conf,
# neither of which the calling application can write.
#
# That separation is the point. If the application's database is compromised and
# every domain in it is flipped to full access, this script still refuses any
# domain or verb its own config does not list. Authority does not live where the
# application can reach it.
#
# ── Design notes ────────────────────────────────────────────────────────────
#
# POSIX sh, and no dependencies beyond coreutils, flock, and the mail server's
# own tools. This runs as root and edits root-owned files, so a bug here is a
# root bug: it is kept small enough to audit in one sitting, which is the whole
# reason for putting it on the server rather than letting the client send
# arbitrary commands.
#
# Every token is validated against a character class before it reaches a file
# or a command line. Nothing is ever interpolated into a shell.
#
# Secrets arrive on stdin, never in argv — /proc/*/cmdline is world-readable.
#
# ── Invocation ──────────────────────────────────────────────────────────────
#
#   mainly-provision setup        interactive: install, configure, issue a key
#   mainly-provision status       what is installed, and whether it is healthy
#   mainly-provision doctor       every check, with the fix for each failure
#   mainly-provision uninstall    remove all of it; touches no address, no mail
#
#   mainly-provision --stdin      verb line on stdin, then any secret     (SSH)
#   mainly-provision <verb…>      verb in argv                    (testing, cron)
#
# The first four administer this host and are reachable only from a real argv
# on it — see the dispatcher below. The rest are the wire protocol.
#
# --stdin is what the forced command uses, because `sudo` resets the
# environment and would drop $SSH_ORIGINAL_COMMAND. $SSH_ORIGINAL_COMMAND is
# still honoured when it survives, for operators who prefer to keep it with
# `Defaults:mailprov env_keep += "SSH_ORIGINAL_COMMAND"`.
#
# ── Grammar ─────────────────────────────────────────────────────────────────
#
#   probe
#   list        <domain>
#   create      <localpart> <domain>            password on stdin
#   delete      <localpart> <domain> [--purge]
#   password    <localpart> <domain>            password on stdin
#   alias-list  <domain>
#   alias-add   <alias> <domain> <target@domain>
#   alias-del   <alias> <domain>
#
# Output is one JSON object on stdout, always, success or failure.

set -eu

VERSION=1

# ── Exit codes ──────────────────────────────────────────────────────────────
EX_OK=0
EX_GRAMMAR=64      # malformed request, or a token that failed validation
EX_DOMAIN=65       # domain is not in this host's allowlist
EX_VERB=66         # verb is not granted for that domain
EX_STATE=67        # already exists, or does not exist
EX_BUSY=69         # another operation holds the lock
EX_INTERNAL=70     # something failed; state was rolled back

# ── Defaults, overridable in the config file ────────────────────────────────
CONF=${MAINLY_PROVISION_CONF:-/etc/mainly-provision.conf}
VMAPS=/etc/postfix/vmaps
USERS=/etc/dovecot/users
ALIASES=/etc/postfix/virtual_aliases
MAILROOT=/var/mail
SCHEME=SHA512-CRYPT
# `postfix` runs `postfix reload`; `none` skips it; anything else must be the
# absolute path of an executable, run with no arguments. Not a shell string — a
# host where Postfix runs in a container needs a different command, not a
# different language. Only root can write the config, so this grants nothing
# the script does not already have.
RELOAD=postfix
LOCKFILE=/run/lock/mainly-provision.lock
BACKUP_KEEP=20

STAMP=$(date +%Y%m%d%H%M%S)
ROLLBACK_ARMED=

# ── JSON ────────────────────────────────────────────────────────────────────
#
# Values are either fixed strings from this file or tokens that have already
# passed validation, so escaping only has to survive the diagnostic text in
# `detail` — which can contain a mail server's own error message.

json_escape() {
  # Backslash and quote escaped; control characters dropped rather than encoded,
  # because nothing downstream needs them and \u00xx is more code to get wrong.
  printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a' -e 'N' -e '$!ba' -e 's/\n/\\n/g'
}

fail() {
  # fail <exit-code> <error> [detail]
  code=$1; err=$2; detail=${3:-}
  printf '{"ok":false,"version":%s,"error":"%s","detail":"%s"}\n' \
    "$VERSION" "$(json_escape "$err")" "$(json_escape "$detail")"
  exit "$code"
}

# ── Validation ──────────────────────────────────────────────────────────────
#
# Deliberately narrower than RFC 5321. An address this refuses can still be
# created by hand; an address this accepts is one that cannot surprise a shell,
# a Postfix map, or a passwd-file's colon-separated fields.

valid_localpart() {
  case "$1" in
    '' | *[!a-z0-9._+-]* ) return 1 ;;
    [!a-z0-9]* | *[!a-z0-9] ) return 1 ;;
  esac
  [ "${#1}" -le 64 ] || return 1
  return 0
}

valid_domain() {
  case "$1" in
    '' | *[!a-z0-9.-]* ) return 1 ;;
    [!a-z0-9]* | *[!a-z0-9] ) return 1 ;;
    *..* | *.-* | *-.* ) return 1 ;;
    *.* ) ;;
    * ) return 1 ;;
  esac
  [ "${#1}" -le 253 ] || return 1
  return 0
}

valid_address() {
  case "$1" in
    *@* ) ;;
    * ) return 1 ;;
  esac
  valid_localpart "${1%%@*}" || return 1
  valid_domain "${1#*@}" || return 1
  return 0
}

# ── Config ──────────────────────────────────────────────────────────────────
#
# Read with awk rather than sourced. Sourcing a config file as shell is how a
# config file becomes an execution path.

# The config decides which domains may be touched, and `reload` in it names a
# program this script runs as root. Anyone who can write it therefore owns this
# script. `sudo` refuses a group-writable sudoers file and sshd refuses a
# group-writable authorized_keys for exactly this reason; so does this.
#
# Skipped when MAINLY_PROVISION_CONF points somewhere else, which is the
# documented way to exercise the script against scratch copies as an ordinary
# user — that path is a test fixture and grants nothing.
assert_config_trustworthy() {
  [ -n "${MAINLY_PROVISION_CONF:-}" ] && return 0

  owner=$(stat -c %u "$CONF" 2>/dev/null || stat -f %u "$CONF" 2>/dev/null || echo unknown)
  mode=$(stat -c %a "$CONF" 2>/dev/null || stat -f %Lp "$CONF" 2>/dev/null || echo unknown)
  case "$owner" in
    0 ) ;;
    * ) fail $EX_INTERNAL untrusted_config "$CONF must be owned by root" ;;
  esac
  # Group and other are the last two octal digits, and either write bit is
  # fatal. Both are tested: `*[2367]` alone looks only at the final digit, so
  # 0664 — group-writable, the likelier mistake — would have gone through.
  case "$mode" in
    *[2367] | *[2367][0-7] )
      fail $EX_INTERNAL untrusted_config "$CONF is writable by more than root (mode $mode)" ;;
  esac
  return 0
}

load_config() {
  [ -r "$CONF" ] || fail $EX_INTERNAL no_config "$CONF is missing or unreadable"
  assert_config_trustworthy

  for key in vmaps users aliases mailroot scheme reload lock backup_keep; do
    value=$(awk -v k="$key" '$1==k { print $2; exit }' "$CONF")
    [ -n "$value" ] || continue
    case "$key" in
      vmaps)       VMAPS=$value ;;
      users)       USERS=$value ;;
      aliases)     ALIASES=$value ;;
      mailroot)    MAILROOT=$value ;;
      scheme)      SCHEME=$value ;;
      reload)      RELOAD=$value ;;
      lock)        LOCKFILE=$value ;;
      backup_keep) BACKUP_KEEP=$value ;;
    esac
  done

  case "$RELOAD" in
    postfix | none ) ;;
    /* ) [ -x "$RELOAD" ] || fail $EX_INTERNAL bad_reload "$RELOAD is not executable" ;;
    * ) fail $EX_INTERNAL bad_reload 'reload must be "postfix", "none", or an absolute path' ;;
  esac
}

# Long-running Postfix processes cache their maps, so a changed vmaps needs
# this. Dovecot re-reads a passwd-file from its mtime and needs nothing.
reload_mta() {
  case "$RELOAD" in
    none ) return 0 ;;
    postfix ) postfix reload >/dev/null 2>&1 ;;
    * ) "$RELOAD" >/dev/null 2>&1 ;;
  esac
}

# Grants for a domain, comma separated. Empty output and status 1 when the
# domain is not listed at all — the two are different answers and the caller
# reports them differently.
grants_for() {
  awk -v d="$1" '$1=="domain" && $2==d { print $3; f=1; exit } END { exit !f }' "$CONF"
}

require_grant() {
  # require_grant <domain> <verb>
  granted=$(grants_for "$1") \
    || fail $EX_DOMAIN domain_not_allowed "$1 is not listed in $CONF"
  case ",$granted," in
    *",$2,"* ) return 0 ;;
  esac
  fail $EX_VERB verb_not_granted "$1 grants: ${granted:-none}"
}

# ── The write transaction ───────────────────────────────────────────────────

take_lock() {
  # Non-blocking. A queue of provisioning requests is a queue of surprises;
  # "try again" is a better answer than "eventually, in an order nobody chose".
  exec 9>"$LOCKFILE" 2>/dev/null || fail $EX_INTERNAL lock_unavailable "cannot open $LOCKFILE"
  flock -n 9 || fail $EX_BUSY lock_busy 'another provisioning operation is in progress'
}

backup_one() {
  [ -f "$1" ] || return 0
  cp -p "$1" "$1.bak.$STAMP"
}

prune_backups() {
  [ "$BACKUP_KEEP" -gt 0 ] 2>/dev/null || return 0
  ls -1t "$1".bak.* 2>/dev/null | tail -n +$((BACKUP_KEEP + 1)) | while IFS= read -r old; do
    rm -f "$old"
  done
}

arm_rollback() {
  backup_one "$VMAPS"
  backup_one "$USERS"
  backup_one "$ALIASES"
  ROLLBACK_ARMED=1
}

# Always returns 0. It is called immediately before `fail`, and under `set -e` a
# non-zero return here would end the script before the error JSON was printed —
# leaving the caller with an exit code and no explanation of what was restored.
rollback() {
  [ -n "$ROLLBACK_ARMED" ] || return 0
  for f in "$VMAPS" "$USERS" "$ALIASES"; do
    if [ -f "$f.bak.$STAMP" ]; then
      cp -p "$f.bak.$STAMP" "$f" || true
    fi
  done
  postmap "hash:$VMAPS" 2>/dev/null || true
  if [ -f "$ALIASES" ]; then
    postmap "hash:$ALIASES" 2>/dev/null || true
  fi
  reload_mta || true
  return 0
}

# Replace a file's contents from stdin without ever leaving it half-written.
# `cp -p` first so the temp file inherits owner and mode; the redirect then
# truncates and fills it, and `mv` within the same directory is atomic.
write_atomic() {
  target=$1
  tmp="$target.tmp.$$"
  cp -p "$target" "$tmp"
  cat > "$tmp"
  mv -f "$tmp" "$target"
}

# The invariant. An address in vmaps but not in users accepts mail nobody can
# read; an address in users but not in vmaps is a login to a mailbox that will
# never receive. Either is worse than the change not happening.
parity_ok() {
  left=$(awk 'NF && $1 !~ /^#/ { print $1 }' "$VMAPS" | sort)
  right=$(awk -F: 'NF && $1 !~ /^#/ { print $1 }' "$USERS" | sort)
  [ "$left" = "$right" ]
}

commit_maps() {
  # commit_maps <reload-postfix?>
  postmap "hash:$VMAPS" || { rollback; fail $EX_INTERNAL postmap_failed "postmap rejected $VMAPS"; }
  parity_ok || { rollback; fail $EX_INTERNAL parity_broken "$VMAPS and $USERS disagree; both restored"; }
  if [ "${1:-yes}" = yes ]; then
    reload_mta || { rollback; fail $EX_INTERNAL reload_failed 'the mail server would not reload'; }
  fi
  prune_backups "$VMAPS"
  prune_backups "$USERS"
  prune_backups "$ALIASES"
}

# ── Lookups ─────────────────────────────────────────────────────────────────

in_vmaps() { awk -v a="$1" 'NF && $1==a { f=1; exit } END { exit !f }' "$VMAPS"; }
in_users() { awk -F: -v a="$1" 'NF && $1==a { f=1; exit } END { exit !f }' "$USERS"; }
in_aliases() { awk -v a="$1" 'NF && $1==a { f=1; exit } END { exit !f }' "$ALIASES"; }

# ── Password on stdin ───────────────────────────────────────────────────────

read_password() {
  # One line, IFS emptied so leading and trailing spaces survive. `read` returns
  # non-zero on a final line with no newline, which is a normal way for a client
  # to send this, so the status is ignored and the value is what is checked.
  PASSWORD=''
  IFS= read -r PASSWORD || true
  [ -n "$PASSWORD" ] || fail $EX_GRAMMAR no_password 'this verb reads a password on stdin'
  [ "${#PASSWORD}" -ge 8 ] || fail $EX_GRAMMAR password_too_short 'at least 8 characters'
  [ "${#PASSWORD}" -le 1024 ] || fail $EX_GRAMMAR password_too_long 'at most 1024 characters'
}

# Sets $HASHED rather than printing it. A function that prints its result cannot
# also call `fail`: the caller's `$( )` would capture the error JSON instead of
# emitting it, and `exit` inside a command substitution only ends the subshell.
hash_password() {
  # Fed twice because `doveadm pw` prompts for confirmation. On stdin, so it
  # never appears in argv where any user on this host could read it.
  HASHED=$(printf '%s\n%s\n' "$PASSWORD" "$PASSWORD" | doveadm pw -s "$SCHEME" 2>/dev/null) \
    || fail $EX_INTERNAL hash_failed "doveadm pw -s $SCHEME failed"
  # A colon would split the passwd-file's fields; an empty result would create a
  # passwordless mailbox. Neither has ever been seen from doveadm, and neither
  # is survivable, so both are checked.
  case "$HASHED" in
    '' | *:* ) fail $EX_INTERNAL hash_failed 'doveadm pw returned something unusable' ;;
  esac
}

# ── Verbs ───────────────────────────────────────────────────────────────────

do_probe() {
  domains=$(awk '$1=="domain" { printf "%s{\"domain\":\"%s\",\"grants\":[", sep, $2;
                                n=split($3, g, ",");
                                for (i=1; i<=n; i++) printf "%s\"%s\"", (i>1?",":""), g[i];
                                printf "]}"; sep="," }' "$CONF")
  pf=$(postconf -h mail_version 2>/dev/null || echo unknown)
  dc=$(dovecot --version 2>/dev/null | awk '{print $1}' || echo unknown)

  # Every domain with an address on this host, whether or not it is allowed.
  # It is what lets the other end tell "this server will not let mainly touch
  # that domain" from "that domain is not on this server at all" — two answers
  # a refusal alone cannot distinguish, and which need opposite fixes.
  serves=$(awk 'NF && $1 !~ /^#/ && $1 ~ /@/ {
                  sub(/^[^@]*@/, "", $1); if (!seen[$1]++) print $1 }' "$VMAPS" 2>/dev/null |
           sort | awk '{ printf "%s\"%s\"", sep, $0; sep="," }')

  # Reported here because a host whose maps are already out of parity cannot be
  # provisioned at all — every write would roll itself back at the commit check.
  # Better learned from a probe than from a failed create.
  if parity_ok; then parity=true; else parity=false; fi

  printf '{"ok":true,"version":%s,"action":"probe","postfix":"%s","dovecot":"%s","scheme":"%s","parity":%s,"domains":[%s],"serves":[%s]}\n' \
    "$VERSION" "$(json_escape "$pf")" "$(json_escape "$dc")" "$(json_escape "$SCHEME")" "$parity" "$domains" "$serves"
}

do_list() {
  domain=$1
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  require_grant "$domain" list

  # `index($1, d) > 0` is not redundant: index() returns 0 for no match, and
  # `length($1) - length(d) + 1` is *also* 0 whenever the domain is longer than
  # the address — so without it, listing a long domain returned every shorter
  # address in the file, from any domain.
  boxes=$(awk -F'[ \t]+' -v d="@$domain" '
    NF && $1 !~ /^#/ && index($1, d) > 0 && index($1, d) == length($1) - length(d) + 1 {
      printf "%s\"%s\"", sep, substr($1, 1, index($1, "@") - 1); sep=","
    }' "$VMAPS")

  printf '{"ok":true,"version":%s,"action":"list","domain":"%s","mailboxes":[%s]}\n' \
    "$VERSION" "$domain" "$boxes"
}

do_create() {
  local_part=$1; domain=$2
  valid_localpart "$local_part" || fail $EX_GRAMMAR bad_localpart "$local_part"
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  require_grant "$domain" create
  address="$local_part@$domain"

  read_password
  take_lock

  if in_vmaps "$address"; then fail $EX_STATE already_exists "$address is already in $VMAPS"; fi
  if in_users "$address"; then fail $EX_STATE already_exists "$address is already in $USERS"; fi

  hash_password
  arm_rollback

  # The right-hand side is a formality: virtual_transport hands delivery to
  # Dovecot's LMTP, which resolves the path from mail_location, so vmaps is a
  # recipient-validity check and nothing else. It is written in the shape the
  # rest of the file already uses.
  { cat "$VMAPS"; printf '%s %s/\n' "$address" "$local_part"; } | write_atomic "$VMAPS"
  { cat "$USERS"; printf '%s:%s:::::\n' "$address" "$HASHED"; } | write_atomic "$USERS"

  commit_maps yes

  printf '{"ok":true,"version":%s,"action":"create","address":"%s"}\n' "$VERSION" "$address"
}

do_delete() {
  local_part=$1; domain=$2; purge=$3
  valid_localpart "$local_part" || fail $EX_GRAMMAR bad_localpart "$local_part"
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  require_grant "$domain" delete
  if [ "$purge" = yes ]; then require_grant "$domain" purge; fi
  address="$local_part@$domain"

  take_lock

  if ! in_vmaps "$address" && ! in_users "$address"; then
    fail $EX_STATE not_found "$address is not configured on this host"
  fi

  # Everything that could refuse the purge is settled *before* the address is
  # removed. The purge itself has to come last — mail is not destroyed until
  # the address is definitely retired — but a check that runs down there turns
  # a refusal into a half-done operation: address gone, mail kept, caller told
  # it failed. Decide first, act later.
  maildir=
  if [ "$purge" = yes ]; then
    maildir="$MAILROOT/$domain/$local_part"
    case "$maildir" in
      "$MAILROOT"/*/* ) ;;
      * ) fail $EX_INTERNAL bad_maildir "$maildir is not under $MAILROOT" ;;
    esac
    # `rm -rf` on a symlink removes the link and not its target, so this is
    # already safe from deleting anything else — but a Maildir that is a
    # symlink is not one this script created, and quietly discarding somebody's
    # deliberate arrangement is worse than refusing to.
    if [ -L "$maildir" ]; then
      fail $EX_INTERNAL bad_maildir "$maildir is a symlink; remove it by hand"
    fi
  fi

  arm_rollback

  awk -v a="$address" '!(NF && $1==a)' "$VMAPS" | write_atomic "$VMAPS"
  awk -F: -v a="$address" '!(NF && $1==a)' "$USERS" | write_atomic "$USERS"

  commit_maps yes

  # Only after the address is gone, and only when asked. Retiring an address and
  # destroying its mail are different decisions, so they are different grants.
  # Checked above, before anything was written.
  purged=false
  if [ "$purge" = yes ] && [ -d "$maildir" ]; then
    rm -rf -- "$maildir"
    purged=true
  fi

  printf '{"ok":true,"version":%s,"action":"delete","address":"%s","purged":%s}\n' \
    "$VERSION" "$address" "$purged"
}

do_password() {
  local_part=$1; domain=$2
  valid_localpart "$local_part" || fail $EX_GRAMMAR bad_localpart "$local_part"
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  require_grant "$domain" password
  address="$local_part@$domain"

  read_password
  take_lock

  in_users "$address" || fail $EX_STATE not_found "$address is not in $USERS"

  hash_password
  arm_rollback

  # awk rather than sed: the replacement contains $ and / from the crypt hash,
  # and getting those past sed's replacement syntax is a bug waiting to be
  # written. awk treats it as data.
  awk -F: -v a="$address" -v h="$HASHED" \
    '{ if (NF && $1==a) print a ":" h ":::::"; else print }' "$USERS" | write_atomic "$USERS"

  # vmaps did not change, so Postfix has nothing to re-read. Dovecot notices
  # the passwd-file's new mtime by itself.
  parity_ok || { rollback; fail $EX_INTERNAL parity_broken "$VMAPS and $USERS disagree; both restored"; }
  prune_backups "$USERS"

  printf '{"ok":true,"version":%s,"action":"password","address":"%s"}\n' "$VERSION" "$address"
}

do_alias_list() {
  domain=$1
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  require_grant "$domain" alias
  [ -f "$ALIASES" ] || fail $EX_INTERNAL no_alias_file "$ALIASES does not exist"

  # Same suffix check as do_list, and for the same reason.
  rows=$(awk -v d="@$domain" '
    NF && $1 !~ /^#/ && index($1, d) > 0 && index($1, d) == length($1) - length(d) + 1 {
      printf "%s{\"alias\":\"%s\",\"target\":\"%s\"}", sep, $1, $2; sep=","
    }' "$ALIASES")

  printf '{"ok":true,"version":%s,"action":"alias-list","domain":"%s","aliases":[%s]}\n' \
    "$VERSION" "$domain" "$rows"
}

do_alias_add() {
  local_part=$1; domain=$2; target=$3
  valid_localpart "$local_part" || fail $EX_GRAMMAR bad_localpart "$local_part"
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  valid_address "$target" || fail $EX_GRAMMAR bad_target "$target"
  require_grant "$domain" alias
  address="$local_part@$domain"

  take_lock
  if in_aliases "$address"; then fail $EX_STATE already_exists "$address is already an alias"; fi

  arm_rollback
  { cat "$ALIASES"; printf '%s %s\n' "$address" "$target"; } | write_atomic "$ALIASES"

  postmap "hash:$ALIASES" || { rollback; fail $EX_INTERNAL postmap_failed "postmap rejected $ALIASES"; }
  reload_mta || { rollback; fail $EX_INTERNAL reload_failed 'the mail server would not reload'; }
  prune_backups "$ALIASES"

  printf '{"ok":true,"version":%s,"action":"alias-add","address":"%s","target":"%s"}\n' \
    "$VERSION" "$address" "$target"
}

do_alias_del() {
  local_part=$1; domain=$2
  valid_localpart "$local_part" || fail $EX_GRAMMAR bad_localpart "$local_part"
  valid_domain "$domain" || fail $EX_GRAMMAR bad_domain "$domain"
  require_grant "$domain" alias
  address="$local_part@$domain"

  take_lock
  if ! in_aliases "$address"; then fail $EX_STATE not_found "$address is not an alias"; fi

  arm_rollback
  awk -v a="$address" '!(NF && $1==a)' "$ALIASES" | write_atomic "$ALIASES"

  postmap "hash:$ALIASES" || { rollback; fail $EX_INTERNAL postmap_failed "postmap rejected $ALIASES"; }
  reload_mta || { rollback; fail $EX_INTERNAL reload_failed 'the mail server would not reload'; }
  prune_backups "$ALIASES"

  printf '{"ok":true,"version":%s,"action":"alias-del","address":"%s"}\n' "$VERSION" "$address"
}

# ── Interactive administration ──────────────────────────────────────────────
#
# `setup`, `status`, `doctor` and `uninstall` exist because the alternative was
# four pages of copy-and-paste across two machines, and every step of it was
# something this script can do, check, and undo itself.
#
# They are reachable only from a real argv on this machine. The dispatcher at
# the foot of this file hands them off before the wire protocol is parsed, and
# the wire protocol cannot reach them: a request arriving over SSH is
# `--stdin`, and the verb it then reads is matched against a `case` that does
# not name any of them. Nothing a client can send administers this host.

ADMIN_SELF=$0
case "$ADMIN_SELF" in /*) ;; *) ADMIN_SELF="$PWD/$ADMIN_SELF" ;; esac

INSTALLED=/usr/local/sbin/mainly-provision
SUDOERS=/etc/sudoers.d/mainly-provision
FULL_GRANTS=list,create,delete,password,alias,purge

if [ -t 2 ]; then
  B=$(printf '\033[1m'); D=$(printf '\033[2m'); R=$(printf '\033[0m')
  RD=$(printf '\033[31m'); GR=$(printf '\033[32m'); YL=$(printf '\033[33m')
else
  B=''; D=''; R=''; RD=''; GR=''; YL=''
fi

say()  { printf '%s\n' "$*" >&2; }
hdr()  { printf '\n%s%s%s\n' "$B" "$*" "$R" >&2; }
good() { printf '  %s✓%s %s\n' "$GR" "$R" "$*" >&2; }
bad()  { printf '  %s✗%s %s\n' "$RD" "$R" "$*" >&2; }
huh()  { printf '  %s!%s %s\n' "$YL" "$R" "$*" >&2; }
note() { printf '     %s%s%s\n' "$D" "$*" "$R" >&2; }
quit() { printf '\n%s%s%s\n\n' "$RD" "$*" "$R" >&2; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || quit 'Run this with sudo.'; }
need_tty() {
  # A subshell, because POSIX makes a redirection error on a special built-in
  # exit the shell outright — `{ : < /dev/tty; } || …` never reaches the `||`.
  ( : < /dev/tty ) 2>/dev/null || quit 'This needs a terminal, and there is not one here.
Run it from a shell on this machine — over SSH is fine, `docker exec -it` is fine,
a pipe or a CI job is not. Every question below has a default, and taking them
all without being asked is not something this should do quietly.'
}

# Prompts read /dev/tty, not stdin, so `curl … | sh` still works.
ask() {
  # ask <prompt> [default]  → $ANSWER
  if [ -n "${2:-}" ]; then
    printf '\n%s%s%s %s[%s]%s ' "$B" "$1" "$R" "$D" "$2" "$R" >&2
  else
    printf '\n%s%s%s ' "$B" "$1" "$R" >&2
  fi
  ANSWER=''
  IFS= read -r ANSWER < /dev/tty || ANSWER=''
  [ -n "$ANSWER" ] || ANSWER=${2:-}
}

confirm() {
  # confirm <question> [y|n]   default y
  case "${2:-y}" in y) hint='Y/n' ;; *) hint='y/N' ;; esac
  printf '\n%s%s%s %s(%s)%s ' "$B" "$1" "$R" "$D" "$hint" "$R" >&2
  reply=''
  IFS= read -r reply < /dev/tty || reply=''
  [ -n "$reply" ] || reply=${2:-y}
  case "$reply" in [Yy]* ) return 0 ;; * ) return 1 ;; esac
}

# ── Detection ───────────────────────────────────────────────────────────────
#
# Every path this script writes to is asked of Postfix and Dovecot rather than
# assumed, because a wrong guess here edits the wrong file as root. What is
# found is shown, and every answer can be typed over.

# `hash:/etc/postfix/vmaps, hash:/etc/postfix/other` → /etc/postfix/vmaps
strip_maptype() {
  v=${1%%,*}
  v=${v# }
  case "$v" in
    *:/* ) printf '%s' "${v#*:}" ;;
    /*   ) printf '%s' "$v" ;;
    *    ) printf '' ;;
  esac
}

detect() {
  DET_VMAPS=$(strip_maptype "$(postconf -h virtual_mailbox_maps 2>/dev/null || true)")
  DET_ALIASES=$(strip_maptype "$(postconf -h virtual_alias_maps 2>/dev/null || true)")
  DET_TRANSPORT=$(postconf -h virtual_transport 2>/dev/null || true)
  DET_POSTFIX=$(postconf -h mail_version 2>/dev/null || true)
  DET_DOVECOT=$(dovecot --version 2>/dev/null | awk '{print $1}' || true)

  # The passwd-file's path is the last absolute token in passdb's args.
  DET_USERS=$(doveconf -n passdb 2>/dev/null |
    awk '/args *=/ { for (i = NF; i >= 1; i--) if (substr($i, 1, 1) == "/") { print $i; exit } }')
  DET_DRIVER=$(doveconf -n passdb 2>/dev/null | awk '/driver *=/ { print $3; exit }')

  # maildir:/var/mail/%d/%n/Maildir → /var/mail
  DET_MAILROOT=$(doveconf -h mail_location 2>/dev/null |
    sed -e 's/^[a-z]*://' -e 's/%.*//' -e 's#/*$##')

  # The strongest scheme this Dovecot can do. It applies only to passwords set
  # from now on; a passwd-file holding a mix is normal and works fine, so there
  # is nothing to gain by matching whatever the majority of existing rows use.
  if doveadm pw -l 2>/dev/null | tr ' \t' '\n\n' | grep -qx ARGON2ID; then
    DET_SCHEME=ARGON2ID
  else
    DET_SCHEME=SHA512-CRYPT
  fi

  [ -n "$DET_VMAPS" ] || DET_VMAPS=/etc/postfix/vmaps
  [ -n "$DET_USERS" ] || DET_USERS=/etc/dovecot/users
  [ -n "$DET_ALIASES" ] || DET_ALIASES=/etc/postfix/virtual_aliases
  [ -n "$DET_MAILROOT" ] || DET_MAILROOT=/var/mail
}

# Which domains this machine actually accepts mail for: the ones with an
# address in vmaps, plus any listed inline in virtual_mailbox_domains.
domains_served() {
  {
    [ -f "$1" ] && awk 'NF && $1 !~ /^#/ && $1 ~ /@/ { sub(/^[^@]*@/, "", $1); print $1 }' "$1"
    postconf -h virtual_mailbox_domains 2>/dev/null | tr ', \t' '\n\n\n'
  } 2>/dev/null | grep '\.' | grep -v ':' | sort -u
}

# The address the mainly host will use to reach this one. Guessed from the
# first global-scope address on this machine, which is right often enough to
# be worth offering and always worth typing over.
guess_host() {
  # A pipeline's status is the last command's, so `ip … | awk` succeeds even
  # when `ip` is absent. Each source is therefore tested for a result, not for
  # an exit code.
  found=''
  if command -v ip >/dev/null 2>&1; then
    found=$(ip -o -4 addr show scope global 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }')
  fi
  [ -n "$found" ] || found=$(hostname -I 2>/dev/null | awk '{ print $1 }')
  printf '%s' "$found"
}

host_fingerprints() {
  for f in /etc/ssh/ssh_host_*_key.pub; do
    [ -f "$f" ] || continue
    ssh-keygen -lf "$f" 2>/dev/null | awk '{print $2}' | sed 's/^SHA256:/sha256:/'
  done
}

sshd_port() {
  p=$(sshd -T 2>/dev/null | awk '$1 == "port" { print $2; exit }')
  [ -n "$p" ] || p=$(awk '$1 == "Port" { print $2; exit }' /etc/ssh/sshd_config 2>/dev/null)
  printf '%s' "${p:-22}"
}

# ── setup ───────────────────────────────────────────────────────────────────

do_setup() {
  need_root
  need_tty
  command -v postconf >/dev/null 2>&1 || quit 'Postfix is not installed here. This is the mail server half of the setup — run it on the machine that receives your mail.'
  command -v doveadm  >/dev/null 2>&1 || quit 'Dovecot is not installed here. This is the mail server half of the setup — run it on the machine that receives your mail.'
  command -v ssh-keygen >/dev/null 2>&1 || quit 'ssh-keygen is missing. Install openssh-client.'

  hdr 'mainly-provision setup'
  say "  ${D}This machine, the mail server, will accept one SSH key that can do${R}"
  say "  ${D}nothing but run this script. What it may then do is decided here,${R}"
  say "  ${D}in a file mainly cannot write.${R}"

  detect

  hdr '1. What is here'
  [ -n "$DET_POSTFIX" ] && good "postfix $DET_POSTFIX" || bad 'postfix — could not read its version'
  [ -n "$DET_DOVECOT" ] && good "dovecot $DET_DOVECOT" || bad 'dovecot — could not read its version'
  case "$DET_DRIVER" in
    passwd-file ) good "dovecot authenticates from a passwd-file" ;;
    '' ) huh "could not read Dovecot's passdb; assuming a passwd-file" ;;
    * ) bad "dovecot authenticates with the '$DET_DRIVER' driver"
        note 'This setup writes flat files. An SQL- or LDAP-backed server needs'
        note 'a different driver — see docs/domain-control.md.'
        confirm 'Continue anyway?' n || quit 'Stopped.' ;;
  esac
  case "$DET_TRANSPORT" in
    lmtp:* ) good "delivery over $DET_TRANSPORT" ;;
    '' ) huh 'no virtual_transport set' ;;
    * ) huh "delivery over $DET_TRANSPORT" ;;
  esac
  say ''
  note "addresses   $DET_VMAPS"
  note "passwords   $DET_USERS"
  note "aliases     $DET_ALIASES"
  note "mail        $DET_MAILROOT"
  note "hashing     $DET_SCHEME"

  if confirm 'Are those four paths right?' y; then
    :
  else
    ask 'Postfix virtual mailbox map'   "$DET_VMAPS";    DET_VMAPS=$ANSWER
    ask 'Dovecot passwd-file'           "$DET_USERS";    DET_USERS=$ANSWER
    ask 'Postfix virtual alias map'     "$DET_ALIASES";  DET_ALIASES=$ANSWER
    ask 'Mail root'                     "$DET_MAILROOT"; DET_MAILROOT=$ANSWER
  fi

  [ -f "$DET_VMAPS" ] || quit "$DET_VMAPS does not exist. Create it, or point this at the file Postfix really uses."
  [ -f "$DET_USERS" ] || quit "$DET_USERS does not exist. Create it, or point this at the file Dovecot really uses."

  # A host already out of parity cannot be provisioned at all: every write
  # would roll itself back at the commit check. Better found now than during a
  # create somebody is waiting on.
  hdr '2. Are the two files in agreement'
  left=$(awk 'NF && $1 !~ /^#/ { print $1 }' "$DET_VMAPS" | sort)
  right=$(awk -F: 'NF && $1 !~ /^#/ { print $1 }' "$DET_USERS" | sort)
  if [ "$left" = "$right" ]; then
    good "in parity — $(printf '%s\n' "$left" | grep -c . || true) addresses"
  else
    bad 'they disagree, and provisioning refuses to run on a host in that state'
    say ''
    printf '%s\n' "$left" > /tmp/.mp-l.$$; printf '%s\n' "$right" > /tmp/.mp-r.$$
    diff /tmp/.mp-l.$$ /tmp/.mp-r.$$ | sed 's/^/     /' >&2 || true
    rm -f /tmp/.mp-l.$$ /tmp/.mp-r.$$
    say ''
    note "< only in $DET_VMAPS  — accepts mail nobody can read"
    note "> only in $DET_USERS  — a login to a mailbox that will never receive"
    note 'Reconcile by hand, then run setup again.'
    quit 'Stopped: fix parity first.'
  fi

  hdr '3. Which domains may mainly manage'
  served=$(domains_served "$DET_VMAPS")
  if [ -n "$served" ]; then
    printf '%s\n' "$served" | sed "s/^/     $D/;s/\$/$R/" >&2
    default=$(printf '%s\n' "$served" | tr '\n' ',' | sed 's/,$//')
  else
    huh 'no domains found in the maps — this server may not be serving any yet'
    default=''
  fi
  ask 'Domains, comma separated' "$default"
  domains=$(printf '%s' "$ANSWER" | tr ', \t' '\n\n\n' | grep . | tr 'A-Z' 'a-z' | sort -u)
  [ -n "$domains" ] || quit 'No domains given. Nothing to set up.'
  for d in $domains; do
    valid_domain "$d" || quit "'$d' is not a domain name."
  done

  hdr '4. What may it do to them'
  say "  ${D}full      everything below${R}"
  say "  ${D}keep      create, delete, passwords, aliases — never destroys stored mail${R}"
  say "  ${D}read      see which addresses exist, and nothing else${R}"
  say ''
  note 'full adds one thing keep does not: deleting an address may also destroy'
  note 'its Maildir. Without it, a deleted address stops receiving and its mail'
  note 'stays on disk, so recreating the address brings everything back.'
  ask 'Scope — full, keep, read, or a comma-separated list' full
  case "$ANSWER" in
    full ) grants=$FULL_GRANTS ;;
    keep ) grants=list,create,delete,password,alias ;;
    read ) grants=list ;;
    *    ) grants=$(printf '%s' "$ANSWER" | tr -d ' \t') ;;
  esac
  for g in $(printf '%s' "$grants" | tr ',' ' '); do
    case "$g" in
      list|create|delete|password|alias|purge ) ;;
      * ) quit "'$g' is not a grant. Valid: list, create, delete, password, alias, purge." ;;
    esac
  done

  hdr '5. Installing'

  if [ "$ADMIN_SELF" != "$INSTALLED" ]; then
    [ -f "$ADMIN_SELF" ] || quit "Cannot find this script's own file to install it. Save it to disk first, then run: sudo sh mainly-provision setup"
    install -m 0755 -o root -g root "$ADMIN_SELF" "$INSTALLED"
    good "$INSTALLED"
  else
    good "$INSTALLED (already here)"
  fi

  # Written fresh every time, with every path spelled out. A file whose values
  # are half explicit and half inherited from this script's defaults is one
  # nobody can read an answer off.
  umask 022
  {
    printf '# mainly-provision — what this mail server will let mainly do.\n'
    printf '#\n'
    printf '# Written by `mainly-provision setup` on %s.\n' "$(date -u '+%Y-%m-%d %H:%M UTC')"
    printf '#\n'
    printf '# This is the gate that decides. mainly cannot write it, so nothing that\n'
    printf '# happens to mainly can widen what this machine will agree to. Narrowing a\n'
    printf '# line here takes effect on the next call; there is nothing to restart.\n'
    printf '\n'
    printf 'vmaps    %s\n' "$DET_VMAPS"
    printf 'users    %s\n' "$DET_USERS"
    printf 'aliases  %s\n' "$DET_ALIASES"
    printf 'mailroot %s\n' "$DET_MAILROOT"
    printf 'scheme   %s\n' "$DET_SCHEME"
    printf 'reload   postfix\n'
    printf '\n'
    printf '# domain <name> <comma-separated grants>\n'
    printf '#   list create delete password alias purge\n'
    for d in $domains; do printf 'domain %s %s\n' "$d" "$grants"; done
  } > "$CONF"
  chown root:root "$CONF"
  chmod 0644 "$CONF"
  good "$CONF"

  if id mailprov >/dev/null 2>&1; then
    good 'account mailprov (already here)'
  else
    # /bin/sh and not nologin: sshd runs a forced command *through* the
    # account's login shell, so nologin accepts the connection, prints "This
    # account is currently not available", and never runs the script — which
    # looks like a correct setup where every call mysteriously fails.
    if command -v adduser >/dev/null 2>&1; then
      adduser --system --group --shell /bin/sh --home /home/mailprov --disabled-password mailprov >/dev/null
    else
      useradd --system --shell /bin/sh --home-dir /home/mailprov --create-home mailprov
      passwd -l mailprov >/dev/null 2>&1 || true
    fi
    good 'account mailprov, no password, shell /bin/sh'
  fi
  MAILPROV_HOME=$(getent passwd mailprov | cut -d: -f6)
  [ -n "$MAILPROV_HOME" ] || MAILPROV_HOME=/home/mailprov
  mkdir -p "$MAILPROV_HOME"

  printf 'mailprov ALL=(root) NOPASSWD: %s\n' "$INSTALLED" > "$SUDOERS.tmp"
  chmod 0440 "$SUDOERS.tmp"
  if visudo -cqf "$SUDOERS.tmp" >/dev/null 2>&1; then
    mv -f "$SUDOERS.tmp" "$SUDOERS"
    good "$SUDOERS — sudo for that one path, and nothing else"
  else
    rm -f "$SUDOERS.tmp"
    quit 'visudo rejected the sudoers line. Nothing was written.'
  fi

  hdr '6. The key'

  # Generated here, handed over once, and then removed from this machine. A
  # private key sitting on the server it unlocks is one more thing that has to
  # stay secret for no benefit — mainly is the only thing that needs it, and
  # re-running setup issues a new one in seconds.
  KEYDIR=$(mktemp -d) || quit 'Could not make a temporary directory.'
  chmod 700 "$KEYDIR"
  ssh-keygen -q -t ed25519 -f "$KEYDIR/key" -N '' -C 'mainly-provision' </dev/null
  mkdir -p "$MAILPROV_HOME/.ssh"
  # `restrict` denies port forwarding, agent forwarding, a PTY, X11 and
  # ~/.ssh/rc. With the forced command, the only thing this key can cause is
  # one run of this script.
  printf 'command="sudo %s --stdin",restrict %s\n' "$INSTALLED" "$(cat "$KEYDIR/key.pub")" \
    > "$MAILPROV_HOME/.ssh/authorized_keys"
  chown -R mailprov:"$(id -gn mailprov)" "$MAILPROV_HOME/.ssh"
  chmod 700 "$MAILPROV_HOME/.ssh"
  chmod 600 "$MAILPROV_HOME/.ssh/authorized_keys"
  good "installed in $MAILPROV_HOME/.ssh/authorized_keys, pinned to one command"

  hdr '7. Checking it works'
  if reply=$(printf 'probe\n' | "$INSTALLED" --stdin 2>&1) && \
     printf '%s' "$reply" | grep -q '"ok":true'; then
    good 'the script answers, and its config parses'
  else
    bad 'the script would not answer'
    printf '%s\n' "$reply" | sed 's/^/     /' >&2
    rm -rf "$KEYDIR"
    quit 'Stopped. Nothing above this point is undone; fix and run setup again.'
  fi

  hdr '8. Where mainly reaches this machine'
  ask 'Address the mainly host should connect to' "$(guess_host)"
  reach_host=$ANSWER
  [ -n "$reach_host" ] || quit 'No address given.'
  ask 'SSH port' "$(sshd_port)"
  reach_port=$ANSWER

  fps=$(host_fingerprints | awk '{ printf "%s\"%s\"", sep, $0; sep="," }')
  doms=$(printf '%s\n' $domains | awk '{ printf "%s\"%s\"", sep, $0; sep="," }')
  grts=$(printf '%s' "$grants" | tr ',' '\n' | awk 'NF { printf "%s\"%s\"", sep, $0; sep="," }')

  blob=$(printf '{"v":1,"host":"%s","port":%s,"user":"mailprov","fingerprints":[%s],"domains":[%s],"grants":[%s],"key":"%s"}' \
    "$(json_escape "$reach_host")" "${reach_port:-22}" "$fps" "$doms" "$grts" \
    "$(json_escape "$(cat "$KEYDIR/key")")" | base64 | tr -d '\n')

  rm -rf "$KEYDIR"

  hdr 'Done. One command left, on the machine running mainly:'
  say ''
  printf '%s./mainly.sh domain connect %s%s\n' "$B" "$blob" "$R"
  say ''
  note 'That string carries the private key. Paste it into that terminal and'
  note 'nowhere else — not a chat, not an issue, not a paste service. It is'
  note 'not stored on this machine; if you lose it, run setup again for a new'
  note 'one, which also revokes this one.'
  say ''
  say "  ${D}Afterwards: mainly-provision status · doctor · uninstall${R}"
  say ''
}

# ── Checks, shared by status and doctor ─────────────────────────────────────

FAILED=0

check_all() {
  verbose=${1:-no}

  if [ -x "$INSTALLED" ]; then good "installed at $INSTALLED"
  else bad "not installed at $INSTALLED"; FAILED=1
       [ "$verbose" = yes ] && note 'Run: sudo sh mainly-provision setup'; fi

  if [ -f "$CONF" ]; then
    owner=$(stat -c %u "$CONF" 2>/dev/null || stat -f %u "$CONF" 2>/dev/null || echo '?')
    mode=$(stat -c %a "$CONF" 2>/dev/null || stat -f %Lp "$CONF" 2>/dev/null || echo '?')
    if [ "$owner" = 0 ]; then
      case "$mode" in
        *[2367] | *[2367][0-7] )
          bad "$CONF is writable by more than root (mode $mode)"; FAILED=1
          [ "$verbose" = yes ] && note "Run: sudo chmod 0644 $CONF" ;;
        * ) good "$CONF — root-owned, mode $mode" ;;
      esac
    else
      bad "$CONF is not owned by root"; FAILED=1
      [ "$verbose" = yes ] && note "Run: sudo chown root:root $CONF"
    fi
  else
    bad "$CONF is missing"; FAILED=1
    [ "$verbose" = yes ] && note 'Run: sudo mainly-provision setup'
    return 0
  fi

  load_config

  for f in "$VMAPS" "$USERS"; do
    [ -f "$f" ] && good "$f" || { bad "$f — named in $CONF, but not there"; FAILED=1; }
  done

  if [ -f "$VMAPS" ] && [ -f "$USERS" ]; then
    if parity_ok; then
      good "maps agree — $(awk 'NF && $1 !~ /^#/' "$VMAPS" | wc -l | tr -d ' ') addresses"
    else
      bad 'the two maps disagree; no write can succeed until they are reconciled'
      FAILED=1
      if [ "$verbose" = yes ]; then
        note "diff <(awk 'NF{print \$1}' $VMAPS | sort) \\"
        note "     <(awk -F: 'NF{print \$1}' $USERS | sort)"
        note 'Delete the orphan, or add the missing half, then: postmap hash:'"$VMAPS"
      fi
    fi
  fi

  if id mailprov >/dev/null 2>&1; then
    shell=$(getent passwd mailprov | cut -d: -f7)
    home=$(getent passwd mailprov | cut -d: -f6)
    case "$shell" in
      */nologin | */false )
        bad "mailprov's shell is $shell"
        FAILED=1
        [ "$verbose" = yes ] && {
          note 'sshd runs the forced command through the login shell, so this'
          note 'accepts the connection and then never runs the script.'
          note 'Run: sudo chsh -s /bin/sh mailprov'
        } ;;
      * ) good "account mailprov, shell $shell" ;;
    esac
    ak="$home/.ssh/authorized_keys"
    if [ -s "$ak" ]; then
      if grep -q 'command=' "$ak"; then
        good "one key installed, $(ssh-keygen -lf "$ak" 2>/dev/null | awk '{print $2}' | head -1)"
      else
        bad "$ak has a key with no forced command — it can open a shell"
        FAILED=1
        [ "$verbose" = yes ] && note 'Run setup again to replace it.'
      fi
    else
      bad 'no key installed — mainly cannot reach this machine'
      FAILED=1
      [ "$verbose" = yes ] && note 'Run: sudo mainly-provision setup'
    fi
  else
    bad 'no mailprov account'; FAILED=1
    [ "$verbose" = yes ] && note 'Run: sudo mainly-provision setup'
  fi

  if [ -f "$SUDOERS" ]; then
    if visudo -cqf "$SUDOERS" >/dev/null 2>&1; then good "$SUDOERS"
    else bad "$SUDOERS does not parse"; FAILED=1; fi
  else
    bad "$SUDOERS is missing — the script cannot reach root"; FAILED=1
    [ "$verbose" = yes ] && note 'Run: sudo mainly-provision setup'
  fi

  command -v doveadm >/dev/null 2>&1 && good "hashing with $SCHEME" || {
    bad 'doveadm is not on PATH; passwords cannot be hashed'; FAILED=1; }

  return 0
}

do_status() {
  need_root
  hdr 'mainly-provision'
  pf=$(postconf -h mail_version 2>/dev/null || echo unknown)
  dc=$(dovecot --version 2>/dev/null | awk '{print $1}' || echo unknown)
  note "postfix $pf · dovecot $dc"
  say ''
  check_all no
  if [ -f "$CONF" ]; then
    hdr 'Domains'
    if awk '$1 == "domain"' "$CONF" | grep -q .; then
      awk -v d="$D" -v r="$R" '$1 == "domain" { printf "     %s  %s%s%s\n", $2, d, $3, r }' "$CONF" >&2
    else
      note 'none listed'
    fi
  fi
  say ''
  [ "$FAILED" = 0 ] || { say "  ${YL}Something is wrong. Run: sudo mainly-provision doctor${R}"; say ''; exit 1; }
}

do_doctor() {
  need_root
  hdr 'Checking every layer'
  check_all yes

  hdr 'End to end'
  if reply=$(printf 'probe\n' | "$INSTALLED" --stdin 2>&1) && printf '%s' "$reply" | grep -q '"ok":true'; then
    good 'the script runs and answers'
    printf '     %s%s%s\n' "$D" "$reply" "$R" >&2
  else
    bad 'the script would not answer'
    printf '%s\n' "$reply" | sed 's/^/     /' >&2
    FAILED=1
  fi

  say ''
  if [ "$FAILED" = 0 ]; then
    say "  ${GR}This half is healthy.${R}"
    say ''
    note 'If mainly still cannot reach it, the fault is between the two machines:'
    note '  · is the SSH port open from the mainly host'
    note '  · does the address in mainly match this machine'
    note 'On the mainly host, run: ./mainly.sh domain doctor'
  else
    say "  ${RD}Fix the ✗ lines above, then run this again.${R}"
  fi
  say ''
  [ "$FAILED" = 0 ] || exit 1
}

do_uninstall() {
  need_root
  need_tty
  hdr 'Uninstall'
  note 'This removes the key, the permissions and this script.'
  note 'It removes no address, no mailbox, and no mail. Everything created'
  note 'through domain control stays exactly as it is.'

  confirm 'Remove it?' n || { say ''; say '  Cancelled.'; say ''; exit 0; }

  home=$(getent passwd mailprov 2>/dev/null | cut -d: -f6)
  if [ -n "$home" ] && [ -f "$home/.ssh/authorized_keys" ]; then
    rm -f "$home/.ssh/authorized_keys"
    good 'key removed — mainly can no longer reach this machine'
  fi
  rm -f "$SUDOERS"      && good "$SUDOERS"
  rm -f "$CONF"         && good "$CONF"

  if id mailprov >/dev/null 2>&1 && confirm 'Remove the mailprov account too?' y; then
    # `deluser --remove-home` needs perl, which a slim host may not have, and it
    # fails as a whole when perl is missing rather than removing the account and
    # skipping the directory. So: try it, fall back to removing the account
    # alone, then take the directory with coreutils — and check the result
    # instead of assuming it, because reporting a removal that did not happen is
    # worse than reporting the failure.
    if command -v deluser >/dev/null 2>&1; then
      deluser --remove-home mailprov >/dev/null 2>&1 || deluser mailprov >/dev/null 2>&1 || true
    else
      userdel -r mailprov >/dev/null 2>&1 || userdel mailprov >/dev/null 2>&1 || true
    fi

    if id mailprov >/dev/null 2>&1; then
      bad 'the mailprov account is still here'
      note 'Its key is gone, so mainly cannot reach this machine either way.'
      note 'Remove the account by hand:  sudo userdel -r mailprov'
    else
      # Only under the directories an account of this kind is ever given. The
      # path comes from passwd, and passwd is editable.
      case "$home" in
        /home/?* | /var/lib/?* ) [ -d "$home" ] && rm -rf -- "$home" ;;
      esac
      good 'account mailprov'
    fi
  fi

  rm -f "$INSTALLED" && good "$INSTALLED"
  say ''
  say "  ${D}On the mainly host, finish with: ./mainly.sh domain forget <domain>${R}"
  say ''
}

# ── Request parsing ─────────────────────────────────────────────────────────
#
# The verb comes from argv, from $SSH_ORIGINAL_COMMAND, or from the first line
# of stdin — in that order. Whichever it is, every token is validated below
# before it reaches anything, so the source of the request changes nothing
# about how much it is trusted.

# Administration first, and only from argv. A request arriving over SSH is
# `--stdin`, so it never matches here; the verb it then carries is matched
# against the `case` at the foot of this file, which names none of these. There
# is no path from the wire to the administration of this host.
if [ $# -gt 0 ] && [ "$1" != --stdin ]; then
  case "$1" in
    setup )     do_setup;     exit 0 ;;
    status )    do_status;    exit 0 ;;
    doctor )    do_doctor;    exit 0 ;;
    uninstall ) do_uninstall; exit 0 ;;
    version )   printf 'mainly-provision protocol v%s\n' "$VERSION"; exit 0 ;;
    help | --help | -h )
      say ''
      say "  ${B}mainly-provision${R} — the mail server half of mainly's domain control."
      say ''
      say "  ${B}setup${R}        install it, choose what it may do, issue mainly a key"
      say "  status       what is installed here, and whether it is healthy"
      say "  doctor       every check, with the fix for each failure"
      say "  uninstall    remove all of it — no address and no mail is touched"
      say ''
      say "  ${D}Run setup here, then paste the one command it prints into a${R}"
      say "  ${D}shell on the machine running mainly.${R}"
      say ''
      exit 0 ;;
  esac
fi

if [ $# -gt 0 ] && [ "$1" != --stdin ]; then
  :
elif [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
  # Word splitting with globbing disabled. No expansion happens on the result
  # of an expansion in POSIX sh, so this cannot execute anything.
  set -f
  IFS=' 	
'
  # shellcheck disable=SC2086
  set -- $SSH_ORIGINAL_COMMAND
  set +f
  unset IFS
else
  line=''
  IFS= read -r line || true
  [ -n "$line" ] || fail $EX_GRAMMAR no_command 'no verb in argv, $SSH_ORIGINAL_COMMAND, or on stdin'
  set -f
  IFS=' 	'
  # shellcheck disable=SC2086
  set -- $line
  set +f
  unset IFS
fi

[ $# -gt 0 ] || fail $EX_GRAMMAR no_command 'empty request'

# Reject anything outside the character class before the grammar is even
# considered. After this loop no argument can contain a shell metacharacter, a
# newline, a colon, or a space.
for arg in "$@"; do
  case "$arg" in
    *[!a-zA-Z0-9._+@-]* ) fail $EX_GRAMMAR bad_token 'a token contained a character that is never valid here' ;;
  esac
done

verb=$1
shift

load_config

case "$verb" in
  probe)
    [ $# -eq 0 ] || fail $EX_GRAMMAR bad_arity 'probe takes no arguments'
    do_probe ;;

  list)
    [ $# -eq 1 ] || fail $EX_GRAMMAR bad_arity 'list <domain>'
    do_list "$1" ;;

  create)
    [ $# -eq 2 ] || fail $EX_GRAMMAR bad_arity 'create <localpart> <domain>'
    do_create "$1" "$2" ;;

  delete)
    purge=no
    case "${3:-}" in
      # `--purge` never reaches the validation loop above — it is stripped from
      # SSH_ORIGINAL_COMMAND's split as a plain token, and `-` is in the class.
      --purge | purge ) purge=yes ;;
      '' ) ;;
      * ) fail $EX_GRAMMAR bad_arity 'delete <localpart> <domain> [--purge]' ;;
    esac
    [ $# -ge 2 ] && [ $# -le 3 ] || fail $EX_GRAMMAR bad_arity 'delete <localpart> <domain> [--purge]'
    do_delete "$1" "$2" "$purge" ;;

  password)
    [ $# -eq 2 ] || fail $EX_GRAMMAR bad_arity 'password <localpart> <domain>'
    do_password "$1" "$2" ;;

  alias-list)
    [ $# -eq 1 ] || fail $EX_GRAMMAR bad_arity 'alias-list <domain>'
    do_alias_list "$1" ;;

  alias-add)
    [ $# -eq 3 ] || fail $EX_GRAMMAR bad_arity 'alias-add <alias> <domain> <target@domain>'
    do_alias_add "$1" "$2" "$3" ;;

  alias-del)
    [ $# -eq 2 ] || fail $EX_GRAMMAR bad_arity 'alias-del <alias> <domain>'
    do_alias_del "$1" "$2" ;;

  * )
    fail $EX_GRAMMAR unknown_verb "$verb" ;;
esac

exit $EX_OK
