{
  "name": "@mail/backend",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "benchmark:db": "node --env-file=../.env --experimental-strip-types scripts/database-benchmark.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "contract:check": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.9.17",
    "nodemailer": "^9.0.4",
    "pg": "^8.13.1",
    "sanitize-html": "^2.14.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.13.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.7.2"
  }
}
