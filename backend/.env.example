# Copy to .env and fill in. Never commit the filled version.
# Values below are placeholders, not real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# api | sync | all. Self-hosted uses "all"; scale-hosted splits them.
ROLE=all
PORT=5274
HOST=127.0.0.1
LOG_LEVEL=info

# ── Origins ──────────────────────────────────────────────────────────────────
# Exact origin of the frontend. CORS is locked to this; no wildcard.
APP_ORIGIN=http://localhost:5273

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://mail:mail@localhost:5432/mail
DATABASE_POOL_MAX=10
# Account syncs retain one advisory-lock connection each. Keep this below the
# database pool so API queries always have reserved capacity.
SYNC_MAX_CONCURRENT_ACCOUNTS=4

# ── Secrets ──────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing this means every account password must be re-entered.
SECRET_KEY=
# Version written with newly sealed mailbox credentials. Defaults to 1.
# SECRET_KEY_VERSION=1
# Retain a prior base64-encoded 32-byte key during a staged rotation.
# SECRET_KEY_V1=
# Session cookie signing key. Generate the same way.
SESSION_SECRET=

# ── IMAP / SMTP ──────────────────────────────────────────────────────────────
# Concurrent IMAP connections across all accounts.
IMAP_POOL_MAX=8
# Per-account cap. Dovecot's default mail_max_userip_connections is 10.
IMAP_PER_ACCOUNT_MAX=2
IMAP_CONNECT_TIMEOUT_MS=15000
# Accounts held on a live IDLE connection. The rest poll.
IMAP_IDLE_MAX_ACCOUNTS=12
SYNC_INTERVAL_MS=120000
SYNC_FOLDER_INTERVAL_MS=600000
BODY_CACHE_TTL_DAYS=30

# Allow IMAP/SMTP hosts on private ranges. Required for self-hosted setups that
# reach the mail server over Tailscale or a LAN. Off by default because the
# verify endpoint takes user-supplied hosts and is therefore an SSRF surface.
#
# It also governs unsubscribe links: with this off, a List-Unsubscribe URL that
# resolves to a private or loopback address is refused rather than followed.
ALLOW_PRIVATE_IMAP_HOSTS=false

# Optional host→address overrides, comma separated, host=ip.
# Used to keep TLS hostname validation working while routing over Tailscale.
# MAIL_HOST_OVERRIDE=mail.cmr.my=100.64.0.1,mail.crnst8.com=100.64.0.1

# ── Optional ─────────────────────────────────────────────────────────────────
# Only needed when running more than one API replica.
# REDIS_URL=redis://localhost:6379

# ── MCP server (mcp/) ────────────────────────────────────────────────────────
# These belong to the MCP process, not the API, and are usually set in the MCP
# client's own config rather than in this file. Listed here so the whole set of
# environment keys lives in one place.
#
# Where the API is. Defaults to http://127.0.0.1:5274/api.
# MAIL_API_URL=
# A token from `./dev.sh token create <email> <name>`. Required, no default.
# MAIL_API_TOKEN=
# Characters of a message body one read may return. Defaults to 8000.
# MAIL_MCP_MAX_BODY_CHARS=
