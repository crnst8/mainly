# mainly configuration.
#
#   cp .env.example .env
#
# Or just run ./mainly.sh start, which writes a .env with generated secrets and
# sensible defaults. Everything below has a default except the three secrets.

# ── The basics ───────────────────────────────────────────────────────────────

# The address you open in a browser, and what CORS is checked against. Behind a
# reverse proxy this is the public URL, not the container's. The scheme is the
# part that matters: an https:// origin is what marks the session cookie Secure,
# and a browser discards a Secure cookie arriving over plain HTTP. First run
# sets this to the best address it found; ./mainly.sh origin <url> changes it.
APP_ORIGIN=http://localhost:5274

# Who is allowed to tell the app the client's IP address.
#
# Leave this unset unless a reverse proxy really is in front. `X-Forwarded-For`
# is a header anybody can send, so trusting it from anybody makes the client
# address a matter of opinion — and the rate limits keyed on it become one fresh
# bucket per forged header.
#
#   unset / false   trust nobody. The connection's own address is the client.
#   1               one reverse proxy in front (nginx, Caddy, Traefik, a tunnel).
#   2               two, e.g. Cloudflare in front of your own proxy.
#   10.0.0.0/8      trust only proxies in these ranges. Comma-separate for more.
#   true            trust the whole chain. Correct only when nothing but the
#                   proxy can reach this port at all.
#
# Set this whenever APP_ORIGIN is https — the app warns at boot if you have not.
# TRUST_PROXY=1

# Host port, and what it listens on. ./mainly.sh start sets BIND_ADDRESS to
# 0.0.0.0 on first run — every interface, so a phone on the same wifi or a
# Tailscale peer reaches it with no proxy and no certificate — unless this
# machine has an address the internet can reach, in which case it binds that
# machine's private address instead. 127.0.0.1 is localhost-only.
# ./mainly.sh bind all|tailscale|lan|local|<address> rewrites it.
PORT=5274
BIND_ADDRESS=127.0.0.1

# ── Secrets. Generate these; never commit them. ──────────────────────────────
#
#   openssl rand -base64 32
#
# SECRET_KEY encrypts stored mailbox passwords with AES-256-GCM. It must decode
# to exactly 32 bytes, and the server refuses to start if it does not. Losing it
# means re-entering the password for every account, so back it up somewhere that
# is not this machine.
SECRET_KEY=
# Signs the session cookie. Rotating it logs everyone out and costs nothing else.
SESSION_SECRET=
# Generated on first run by ./mainly.sh. Avoid /, + and = — it is interpolated
# into a connection URL.
POSTGRES_PASSWORD=

# ── Mail server reachability ─────────────────────────────────────────────────

# Adding an account makes an outbound connection to a hostname you type in, so
# the endpoint that does it is a request-forgery surface. Private, loopback,
# link-local and reserved destinations are refused unless this is on. Turn it on
# when — and only when — your mail server is on a LAN, a VPN or Tailscale.
#
# It governs unsubscribe links too: with this off, a List-Unsubscribe URL
# resolving to a private address is refused rather than followed.
ALLOW_PRIVATE_IMAP_HOSTS=false

# Reach a mail server at a private address while still validating its real
# certificate. Comma separated, host=address. Without this, connecting by IP
# fails hostname validation — and the alternative, disabling verification, is
# not a trade worth making for mail credentials.
#
#   MAIL_HOST_OVERRIDE=mail.example.com=100.64.0.1,mail.example.net=100.64.0.1
MAIL_HOST_OVERRIDE=

# ── Sync tuning ──────────────────────────────────────────────────────────────
# The defaults are sized for a handful of mailboxes on a small VPS. Raise them
# on bigger hardware; the IMAP ones are bounded by what your server allows.

# Concurrent IMAP connections across all accounts.
IMAP_POOL_MAX=8
# Per account. Dovecot's mail_max_userip_connections defaults to 10.
IMAP_PER_ACCOUNT_MAX=2
IMAP_CONNECT_TIMEOUT_MS=15000
# Accounts held on a live IDLE connection for push. The rest poll.
IMAP_IDLE_MAX_ACCOUNTS=12

# How often the poll runs, and how often folders are re-listed.
SYNC_INTERVAL_MS=120000
SYNC_FOLDER_INTERVAL_MS=600000
# How long a fetched body stays cached. Bodies are not stored permanently.
BODY_CACHE_TTL_DAYS=30

# Account syncs each hold an advisory-lock connection. Keep this below
# DATABASE_POOL_MAX so API queries always have reserved capacity.
DATABASE_POOL_MAX=10
SYNC_MAX_CONCURRENT_ACCOUNTS=4

# ── Runtime ──────────────────────────────────────────────────────────────────

# api | sync | all. "all" runs the HTTP server and the sync workers in one
# process, which is what a self-hosted install wants. Splitting them across
# replicas needs no other change: workers claim accounts with Postgres advisory
# locks, so there is no scheduler to run.
ROLE=all

LOG_LEVEL=info

# Where the built web UI is served from. Set in the image; there is no reason to
# change it unless you are serving the frontend separately, in which case unset
# it and this becomes an API-only process.
# WEB_ROOT=/app/web

# Which image tag docker-compose.yml pulls. Pin it to a version to stop
# ./mainly.sh update moving you forward unexpectedly.
# MAINLY_VERSION=latest

# Host port for Postgres, exposed on 127.0.0.1 for pg_dump and inspection only.
# DB_PORT=54329

# Only needed once more than one API replica exists; sessions live in Postgres
# precisely so a single-container install needs no Redis.
# REDIS_URL=redis://localhost:6379

# ── MCP server (mcp/) ────────────────────────────────────────────────────────
# These belong to the MCP process rather than the API, and are normally set in
# the MCP client's own config. Listed here so every environment key this project
# understands lives in one place.
#
# Where the API is. Defaults to http://127.0.0.1:5274/api.
# MAIL_API_URL=
# A token from `./mainly.sh token create <email> <name>`. Required, no default.
# MAIL_API_TOKEN=
# Characters of a message body one read may return. Defaults to 8000.
# MAIL_MCP_MAX_BODY_CHARS=
